# =====================================================================
#  Clínica VidaSalud · variables de entorno
#
#  LOCAL:      copia este archivo a  .env  y rellena tus valores.
#              (docker-compose.yml ya lo carga si existe)
#  RENDER:     las mismas claves se pegan en el panel del servicio,
#              o vienen declaradas en render.yaml.
#  VERCEL:     solo hace falta APP_BASE_URL si publicas la landing allí.
#
#  Nunca subas el archivo .env a git: ya está en .gitignore.
# =====================================================================

# ------------------------- Aplicación -------------------------------
APP_NAME="Clínica VidaSalud"
# URL pública desde la que se sirve la app (los correos usan este valor).
# Local:  http://localhost:8080
# Render: https://TU-SERVICIO.onrender.com
APP_BASE_URL=http://localhost:8080
TZ=America/Bogota

# ------------------------- Base de datos ----------------------------
# Opción A: valores sueltos
DB_HOST=localhost
DB_PORT=5433
DB_NAME=clinica
DB_USER=clinica
DB_PASS=clinica

# Opción B: Render/Neon entregan una sola URL; si DATABASE_URL existe,
# tiene prioridad sobre lo anterior.
# DATABASE_URL=postgres://user:pass@host:5432/clinica

# ------------------------- Correo (envío) ---------------------------
# driver: resend | brevo = API HTTPS (RECOMENDADO en la nube)
#         smtp            = STARTTLS/TLS (solo local)
#         log             = escribe en backend/storage/mail.log
#
# ⚠ Render bloquea TODO el SMTP saliente (25/465/587), así que en la nube
#   hace falta una API key de Resend o Brevo. Ambas son gratuitas.
MAIL_DRIVER=resend

# Clave de la API (Resend: https://resend.com/api-keys)
#                        (Brevo: https://api.brevo.com -> SMTP & API)
MAIL_API_KEY=

# --- Opción SMTP (solo local; no funciona en Render) ---
MAIL_DRIVER_SMTP=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=tu.correo@gmail.com
# Contraseña de aplicación de Gmail (https://myaccount.google.com/apppasswords)
MAIL_PASS=xxxxxxxxxxxxxxxx

# Remitente visible (en Resend debe estar verificado en la cuenta)
MAIL_FROM=tu.correo@gmail.com
MAIL_FROM_NAME="Clínica VidaSalud"
